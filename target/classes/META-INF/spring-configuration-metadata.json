{
  "groups": [
    {
      "name": "mqtt",
      "type": "com.iot.nettymqttdemo.config.MqttProperties",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    }
  ],
  "properties": [
    {
      "name": "mqtt.clean-session",
      "type": "java.lang.Boolean",
      "description": "设置是否清空session,这里如果设置为false表示服务器会保留客户端的连 接记录，这里设置为true表示每次连接到服务器都以新的身份连接",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.client-id",
      "type": "java.lang.String",
      "description": "客户端Id，同一台服务器下，不允许出现重复的客户端id",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.default-topic",
      "type": "java.lang.String",
      "description": "默认连接主题，以\/#结尾表示订阅所有以test开头的主题",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.host-url",
      "type": "java.lang.String",
      "description": "连接地址",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.is-open",
      "type": "java.lang.Boolean",
      "description": "启动的时候是否关闭mqtt",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.keep-alive",
      "type": "java.lang.Integer",
      "description": "设置会话心跳时间 单位为秒 服务器会每隔1.5*20秒的时间向客户端 发送个消息判断客户端是否在线，但这个方法并没有重连的机制",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.password",
      "type": "java.lang.String",
      "description": "密码",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.qos",
      "type": "java.lang.Integer",
      "description": "连接方式",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.reconnect",
      "type": "java.lang.Boolean",
      "description": "是否断线重连",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.server-topic",
      "type": "java.lang.String",
      "description": "默认服务器发送主题前缀，格式：server:${env}:report:${topic}",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.timeout",
      "type": "java.lang.Integer",
      "description": "超时时间",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    },
    {
      "name": "mqtt.username",
      "type": "java.lang.String",
      "description": "用户名",
      "sourceType": "com.iot.nettymqttdemo.config.MqttProperties"
    }
  ],
